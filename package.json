    "gate:a11y": "node gates/pre-merge/accessibility/run.mjs",
    "gate:api-contract": "node gates/pre-merge/api-contract-diff/run.mjs",
    "gate:input-validation": "node gates/pre-merge/input-validation/run.mjs",
    "gate:route-authz": "node gates/pre-merge/route-authz/run.mjs",
