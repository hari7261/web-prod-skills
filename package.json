{
  "name": "web-prod-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source production-readiness skills, security and quality gates, engineering baselines, and evaluation assets for AI coding agents and web application teams.",
  "license": "MIT",
  "homepage": "https://hari7261.github.io/web-prod-skills/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hari7261/web-prod-skills.git"
  },
  "bugs": {
    "url": "https://github.com/hari7261/web-prod-skills/issues"
  },
  "keywords": [
    "ai-coding-agents",
    "production-readiness",
    "agent-skills",
    "web-security",
    "llm-safety",
    "devsecops",
    "quality-gates",
    "prompt-injection",
    "software-engineering",
    "github-pages"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate:secrets": "node gates/pre-commit/secrets-scan/run.mjs",
    "gate:input-validation": "node gates/pre-merge/input-validation/run.mjs",
    "gate:route-authz": "node gates/pre-merge/route-authz/run.mjs",
    "test": "node --test",
    "check": "npm test && npm run gate:secrets && npm run gate:input-validation && npm run gate:route-authz",
    "gate:ai-evals": "node gates/pre-merge/ai-eval-evidence/run.mjs",
    "gate:integrations": "node gates/pre-merge/integration-resilience/run.mjs",
    "gate:observability": "node gates/pre-merge/observability-evidence/run.mjs",
    "gate:migrations": "node gates/pre-deploy/migration-safety/run.mjs",
    "gate:frontend": "node gates/pre-merge/frontend-quality/run.mjs",
    "gate:api-contract": "node gates/pre-merge/api-contract/run.mjs",
    "gate:llm-safety": "node gates/pre-merge/llm-output-safety/run.mjs"
  },
  "devDependencies": {}
}
