{
  "name": "web-prod-skills",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source production-readiness skills, security and quality gates, engineering baselines, and evaluation assets for AI coding agents and web application teams.",
  "license": "MIT",
  "homepage": "https://hari7261.github.io/web-prod-skills/",
